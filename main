      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.32 4.37a19.8 19.8 0 0 0-4.9-1.52.07.07 0 0 0-.08.04c-.21.38-.45.87-.61 1.26a18.3 18.3 0 0 0-5.48 0 12.6 12.6 0 0 0-.62-1.26.08.08 0 0 0-.08-.04c-1.7.29-3.36.8-4.9 1.52a.07.07 0 0 0-.03.03C.53 8.58-.32 12.65.1 16.67a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 6 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-2a.08.08 0 0 0-.04-.11 13 13 0 0 1-1.87-.9.08.08 0 0 1 0-.13c.13-.09.25-.19.37-.29a.07.07 0 0 1 .08 0c3.93 1.8 8.18 1.8 12.06 0a.07.07 0 0 1 .08 0c.12.1.24.2.37.29a.08.08 0 0 1 0 .13c-.6.35-1.22.65-1.87.9a.08.08 0 0 0-.04.11c.37.7.78 1.37 1.23 2a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6.01-3.03.08.08 0 0 0 .03-.06c.5-4.65-.62-8.68-2.6-12.27a.06.06 0 0 0-.03-.03ZM8.02 14.24c-1.18 0-2.15-1.08-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.21 0 2.17 1.1 2.15 2.42 0 1.34-.95 2.42-2.15 2.42Zm7.97 0c-1.18 0-2.15-1.08-2.15-2.42 0-1.33.96-2.42 2.15-2.42 1.21 0 2.17 1.1 2.15 2.42 0 1.34-.94 2.42-2.15 2.42Z"/></svg>
      Mit Discord anmelden
    </button>
    <div class="login-note">Demo-Anmeldung: Da diese Seite ohne eigenen Server läuft, wird der echte Discord-OAuth-Login hier simuliert. Für einen produktiven Einsatz müsste ein Backend die Discord-Rollen automatisch abgleichen.</div>
  </div>
</div>

<!-- ================= DISCORD LOGIN MODAL ================= -->
<div class="modal-overlay" id="login-modal" style="display:none;">
  <div class="modal">
    <h2>Discord-Anmeldung</h2>
    <div class="sub">Simulierter Login &mdash; wähle deinen Namen und deine Hauptklasse.</div>
    <div class="field">
      <label for="in-name">Discord-Name</label>
      <input id="in-name" type="text" placeholder="z. B. Ragnar#0001" autocomplete="off">
    </div>
    <div class="field">
      <label for="in-class">Hauptklasse</label>
      <select id="in-class"></select>
    </div>
    <div class="field">
      <label for="in-rank">Rang (nur für diese Demo wählbar)</label>
      <select id="in-rank">
        <option value="Rekrut">Rekrut</option>
        <option value="Mitglied">Mitglied</option>
        <option value="Offizier">Offizier</option>
        <option value="CoLeader">Co-Leader</option>
        <option value="Leader">Leader</option>
      </select>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="cancel-login">Abbrechen</button>
      <button class="btn btn-primary" id="confirm-login">Beitreten</button>
    </div>
  </div>
</div>

<!-- ================= APP ================= -->
<div id="app-screen">
  <div class="shell">
    <div class="main" id="main"></div>
    <nav class="nav">
      <div class="nav-brand">BlutAdler</div>
      <div class="nav-user" id="nav-user"></div>
      <ul class="nav-links" id="nav-links"></ul>
      <button class="logout-btn" id="logout-btn">Abmelden</button>
    </nav>
  </div>
</div>

<script>
(function(){
  "use strict";

  /* ---------------- State ---------------- */
  let state = {
    currentUser: null,
    view: "home",
    members: [],
    classes: [],
    events: [],
    tickets: [],
    loaded: false,
    openRowMenu: null,
    openClassModalFor: null,
    newEventTyp: "Dungeon"
  };

  const RANK_LABEL = {Leader:"Leader", CoLeader:"Co-Leader", Offizier:"Offizier", Mitglied:"Mitglied", Rekrut:"Rekrut"};
  const RANK_ORDER = ["Leader","CoLeader","Offizier","Mitglied","Rekrut"];

  const EVENT_TYPES = {
    Dungeon: {label:"Dungeon", icon:"🗝️", content:["Fire Temple","Sanctum Library","Dark Poeta","Void Forge","Crow Cave","Draupnir","Urugugu","Vasharti","Horn Den","Nightmare Layer 1"]},
    Raid: {label:"Raid", icon:"⚔️", content:["Ladra","Ascension Trial","Sanctuary-Raid"]},
    PvP: {label:"PvP / Abyss", icon:"🛡️", content:["Abyss-Schlacht","Festungsbelagerung","Open-World PvP"]},
    Treffen: {label:"Gildentreffen", icon:"📋", content:["Gildentreffen","Strategiebesprechung","Rekrutierungs-Event"]},
    Sonstiges: {label:"Sonstiges", icon:"✦", content:null}
  };
  const EVENT_TYPE_ORDER = ["Dungeon","Raid","PvP","Treffen","Sonstiges"];

  function isAdmin(user){
    return user && (user.rank === "Leader" || user.rank === "CoLeader");
  }

  function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

  /* ---------------- Storage ---------------- */
  async function loadAll(){
    try{
      const m = await window.storage.get("members", true);
      state.members = m ? JSON.parse(m.value) : null;
    }catch(e){ state.members = null; }
    try{
      const c = await window.storage.get("classes", true);
      state.classes = c ? JSON.parse(c.value) : null;
    }catch(e){ state.classes = null; }
    try{
      const ev = await window.storage.get("events", true);
      state.events = ev ? JSON.parse(ev.value) : null;
    }catch(e){ state.events = null; }
    try{
      const t = await window.storage.get("tickets", true);
      state.tickets = t ? JSON.parse(t.value) : null;
    }catch(e){ state.tickets = null; }

    if(!state.classes){
      state.classes = ["Templer","Gladiator","Assassine","Ranger","Zauberer","Geistmeister","Kleriker","Kantor"];
      await saveClasses();
    }
    if(!state.members){
      state.members = [
        {id:uid(), name:"Ragnar Sturmklinge", rank:"Leader", hauptklasse:"Templer", klassen:["Templer"]},
        {id:uid(), name:"Elyndra Nachtblut", rank:"CoLeader", hauptklasse:"Zauberer", klassen:["Zauberer","Geistmeister"]},
        {id:uid(), name:"Torvin Eisenfaust", rank:"Offizier", hauptklasse:"Gladiator", klassen:["Gladiator"]},
        {id:uid(), name:"Sira Windfeder", rank:"Mitglied", hauptklasse:"Ranger", klassen:["Ranger","Assassine"]},
        {id:uid(), name:"Dorn Grauwolf", rank:"Rekrut", hauptklasse:"Assassine", klassen:["Assassine"]}
      ];
      await saveMembers();
    }
    // Migration: normalize old single-"klasse" members to hauptklasse/klassen model
    let migrated = false;
    state.members.forEach(m=>{
      if(!m.klassen){
        m.hauptklasse = m.klasse || (state.classes[0] || "");
        m.klassen = m.hauptklasse ? [m.hauptklasse] : [];
        delete m.klasse;
        migrated = true;
      }
    });
    if(migrated) await saveMembers();
    if(!state.events){
      state.events = [
        {id:uid(), typ:"Raid", name:"Ladra", date:"2026-09-14", time:"20:00", desc:"Wöchentlicher Gilden-Raid. Vollständige Gruppe erforderlich, bitte pünktlich einloggen."},
        {id:uid(), typ:"Treffen", name:"Gildentreffen", date:"2026-09-20", time:"19:30", desc:"Besprechung der nächsten Season-Ziele und Loot-Regeln."}
      ];
      await saveEvents();
    }
    // Migration: normalize old free-text events to typ/name model
    let eventsMigrated = false;
    state.events.forEach(ev=>{
      if(!ev.typ){
        ev.typ = "Sonstiges";
        ev.name = ev.title || "Termin";
        delete ev.title;
        eventsMigrated = true;
      }
    });
    if(eventsMigrated) await saveEvents();
    if(!state.tickets){
      state.tickets = [
        {id:uid(), title:"Loot-Verteilung unklar", author:"Sira Windfeder", desc:"Beim letzten Raid war die Regel für epische Drops nicht ganz klar.", status:"Offen", replies:[]}
      ];
      await saveTickets();
    }
    state.loaded = true;
  }

  async function saveMembers(){ try{ await window.storage.set("members", JSON.stringify(state.members), true); }catch(e){} }
  async function saveClasses(){ try{ await window.storage.set("classes", JSON.stringify(state.classes), true); }catch(e){} }
  async function saveEvents(){ try{ await window.storage.set("events", JSON.stringify(state.events), true); }catch(e){} }
  async function saveTickets(){ try{ await window.storage.set("tickets", JSON.stringify(state.tickets), true); }catch(e){} }

  /* ---------------- Login flow ---------------- */
  const loginScreen = document.getElementById("login-screen");
  const appScreen = document.getElementById("app-screen");
  const modal = document.getElementById("login-modal");

  document.getElementById("open-discord-login").addEventListener("click", async ()=>{
    if(!state.loaded) await loadAll();
    const sel = document.getElementById("in-class");
    sel.innerHTML = state.classes.map(c=>`<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join("");
    modal.style.display = "flex";
  });
  document.getElementById("cancel-login").addEventListener("click", ()=>{ modal.style.display = "none"; });

  document.getElementById("confirm-login").addEventListener("click", async ()=>{
    const name = document.getElementById("in-name").value.trim();
    const klasse = document.getElementById("in-class").value;
    const rank = document.getElementById("in-rank").value;
    if(!name){ document.getElementById("in-name").focus(); return; }

    let existing = state.members.find(m => m.name.toLowerCase() === name.toLowerCase());
    if(!existing){
      existing = {id:uid(), name, rank, hauptklasse:klasse, klassen:[klasse]};
      state.members.push(existing);
      await saveMembers();
    } else {
      existing.rank = rank;
      existing.hauptklasse = klasse;
      if(!existing.klassen.includes(klasse)) existing.klassen.push(klasse);
      await saveMembers();
    }
    state.currentUser = existing;
    modal.style.display = "none";
    loginScreen.style.display = "none";
    appScreen.style.display = "block";
    state.view = "home";
    render();
  });

  document.getElementById("logout-btn").addEventListener("click", ()=>{
    state.currentUser = null;
    appScreen.style.display = "none";
    loginScreen.style.display = "flex";
  });

  function escapeHtml(str){
    return String(str).replace(/[&<>"']/g, s=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[s]));
  }

  /* ---------------- Nav ---------------- */
  const NAV_ITEMS = [
    {id:"home", label:"Home", icon:"🏠"},
    {id:"member", label:"Member", icon:"⚔️"},
    {id:"kalender", label:"Kalender", icon:"🗓️"},
    {id:"ticket", label:"Ticket", icon:"🎫"},
    {id:"admin", label:"Admin", icon:"🛡️", adminOnly:true}
  ];

  function renderNav(){
    const navLinks = document.getElementById("nav-links");
    const user = state.currentUser;
    navLinks.innerHTML = NAV_ITEMS
      .filter(item => !item.adminOnly || isAdmin(user))
      .map(item => `
        <li>
          <button data-view="${item.id}" class="${state.view===item.id?'active':''}">
            <span aria-hidden="true">${item.icon}</span>
            <span class="label">${item.label}</span>
          </button>
        </li>`).join("");
    navLinks.querySelectorAll("button").forEach(btn=>{
      btn.addEventListener("click", ()=>{ state.view = btn.dataset.view; render(); });
    });

    document.getElementById("nav-user").innerHTML = user ? `
      <strong>${escapeHtml(user.name)}</strong>
      <span class="badge rank-${user.rank}">${RANK_LABEL[user.rank]}</span>
    ` : "";
  }

  /* ---------------- Views ---------------- */
  function renderHome(){
    const total = state.members.length;
    const dist = RANK_ORDER.map(r => ({r, count: state.members.filter(m=>m.rank===r).length}));
    const nextEvent = [...state.events].sort((a,b)=> new Date(a.date)-new Date(b.date))[0];

    return `
      <div class="home-hero">
        <div class="page-title">Willkommen zurück, ${escapeHtml(state.currentUser.name.split(" ")[0])}</div>
        <p>Die Hallen von BlutAdler stehen offen. Prüfe die Gildenmitglieder, plane den nächsten Raid und behalte offene Anliegen im Blick.</p>
      </div>
      <div class="stat-grid">
        <div class="stat"><div class="num">${total}</div><div class="label">Mitglieder</div></div>
        <div class="stat"><div class="num">${state.classes.length}</div><div class="label">Klassen</div></div>
        <div class="stat"><div class="num">${state.events.length}</div><div class="label">Termine</div></div>
        <div class="stat"><div class="num">${state.tickets.filter(t=>t.status==="Offen").length}</div><div class="label">Offene Tickets</div></div>
      </div>
      <div class="panel">
        <h3>Nächster Termin</h3>
        ${nextEvent ? `
          <div class="event-row">
            <div class="event-date"><div class="d">${new Date(nextEvent.date).getDate()}</div><div class="m">${new Date(nextEvent.date).toLocaleDateString('de-DE',{month:'short'})}</div></div>
            <div class="event-body">
              <h4>${EVENT_TYPES[nextEvent.typ] ? EVENT_TYPES[nextEvent.typ].icon + " " : ""}${escapeHtml(nextEvent.name)}</h4>
              <p>${escapeHtml(nextEvent.desc)}</p>
              <div class="event-time">${nextEvent.time} Uhr</div>
            </div>
          </div>` : `<div class="empty-note">Aktuell sind keine Termine geplant.</div>`}
      </div>
    `;
  }

  function renderMember(){
    const user = state.currentUser;
    const admin = isAdmin(user);

    const rows = state.members.map(m => {
      const extra = (m.klassen || []).length - 1;
      const rowMenuOpen = state.openRowMenu === m.id;
      return `
      <tr>
        <td data-label="Member"><span class="member-name">${escapeHtml(m.name)}</span> ${m.id===user.id?'<span class="you">(du)</span>':''}</td>
        <td data-label="Rolle"><span class="badge rank-${m.rank}">${RANK_LABEL[m.rank]}</span></td>
        <td data-label="Klasse">
          <div class="klasse-cell">
            <span class="class-badge">${escapeHtml(m.hauptklasse || "—")}</span>
            ${extra > 0 ? `<span class="klasse-extra">+${extra}</span>` : ""}
            ${admin ? `<button class="dots-btn" data-action="open-class-modal" data-id="${m.id}" title="Klassen von ${escapeHtml(m.name)} verwalten" aria-label="Klassen von ${escapeHtml(m.name)} verwalten">⋯</button>` : ""}
          </div>
        </td>
        ${admin ? `<td data-label="Admin">
          <div class="cell-menu-wrap">
            <button class="dots-btn" data-action="toggle-row-menu" data-id="${m.id}" title="Optionen für ${escapeHtml(m.name)}" aria-label="Optionen für ${escapeHtml(m.name)}">⋮</button>
            ${rowMenuOpen ? `
              <div class="dots-popover">
                <div class="pop-label">Rang ändern</div>
                ${RANK_ORDER.map(r=>`<button data-action="set-rank" data-id="${m.id}" data-rank="${r}" class="${r===m.rank?'active-rank':''}">${RANK_LABEL[r]}</button>`).join("")}
                <div class="pop-divider"></div>
                <button class="danger" data-action="remove" data-id="${m.id}">Mitglied entfernen</button>
              </div>
            ` : ""}
          </div>
        </td>` : ""}
      </tr>`;
    }).join("");

    return `
      <div class="page-title">Gildenmitglieder</div>
      <div class="page-sub">${state.members.length} Mitglieder in BlutAdler${admin ? " — über die ⋮-Menüs passt du Rang, Klassen und Mitgliedschaft an." : ""}</div>

      <div class="panel" style="overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>Member</th><th>Rolle</th><th>Klasse</th>${admin ? "<th>Admin</th>" : ""}
            </tr>
          </thead>
          <tbody id="member-tbody">${rows}</tbody>
        </table>
      </div>

      ${admin ? `
      <div class="panel">
        <h3>Klassen der Gilde verwalten</h3>
        <div class="page-sub" style="margin-bottom:14px;">Hier legst du fest, welche Klassen es in BlutAdler überhaupt gibt (Standard: die 8 Aion 2-Klassen). Welche davon ein Mitglied spielt, stellst du über die ⋯ hinter der Klasse in der Tabelle ein.</div>
        <div class="class-list" id="class-list">${renderClassChips()}</div>
        <div class="add-class-row">
          <input type="text" id="new-class-input" placeholder="Neue Klasse, z. B. Brawler">
          <button class="btn btn-primary" id="add-class-btn">Hinzufügen</button>
        </div>
      </div>` : ""}

      ${admin ? renderClassModal() : ""}
    `;
  }

  function renderClassChips(){
    return state.classes.map(c => `
      <div class="class-chip">
        <input type="text" value="${escapeHtml(c)}" data-orig="${escapeHtml(c)}" data-action="rename-class">
        <button data-action="delete-class" data-class="${escapeHtml(c)}" title="Klasse löschen" aria-label="Klasse ${escapeHtml(c)} löschen">✕</button>
      </div>
    `).join("");
  }

  function renderClassModal(){
    if(!state.openClassModalFor) return "";
    const m = state.members.find(x=>x.id===state.openClassModalFor);
    if(!m) return "";
    const rows = state.classes.map(c=>{
      const checked = (m.klassen||[]).includes(c);
      const isHaupt = m.hauptklasse === c;
      return `
        <div class="class-check-row">
          <input type="checkbox" id="cls-${c}" data-action="toggle-klasse" data-class="${escapeHtml(c)}" ${checked?'checked':''} ${isHaupt?'disabled':''}>
          <label for="cls-${c}">${escapeHtml(c)}</label>
          ${isHaupt ? `<span class="haupt-tag">Hauptklasse</span>` : (checked ? `<button class="set-haupt" data-action="set-haupt" data-class="${escapeHtml(c)}">Als Hauptklasse</button>` : "")}
        </div>
      `;
    }).join("");

    return `
      <div class="modal-overlay" id="class-modal-overlay">
        <div class="modal">
          <h2>Klassen von ${escapeHtml(m.name)}</h2>
          <div class="sub">Wähle, welche Klassen dieses Mitglied spielt. Die Hauptklasse wurde bei der Anmeldung festgelegt.</div>
          <div class="class-check-list">${rows}</div>
          <div class="modal-actions">
            <button class="btn btn-ghost" id="close-class-modal">Schließen</button>
          </div>
        </div>
      </div>
    `;
  }

  function renderKalender(){
    const admin = isAdmin(state.currentUser);
    const sorted = [...state.events].sort((a,b)=> new Date(a.date)-new Date(b.date));
    const rows = sorted.map(ev => {
      const meta = EVENT_TYPES[ev.typ] || EVENT_TYPES.Sonstiges;
      return `
      <div class="event-row">
        <div class="event-date"><div class="d">${new Date(ev.date).getDate()}</div><div class="m">${new Date(ev.date).toLocaleDateString('de-DE',{month:'short'})}</div></div>
        <div class="event-body">
          <span class="badge evtype-${ev.typ}">${meta.icon} ${meta.label}</span>
          <h4>${escapeHtml(ev.name)}</h4>
          <p>${escapeHtml(ev.desc)}</p>
          <div class="event-time">${ev.time} Uhr</div>
        </div>
        ${admin ? `<button class="btn btn-danger btn-small" data-action="delete-event" data-id="${ev.id}">Löschen</button>` : ""}
      </div>
    `;}).join("");

    const currentTyp = state.newEventTyp || "Dungeon";
    const contentList = EVENT_TYPES[currentTyp].content;

    return `
      <div class="page-title">Kalender</div>
      <div class="page-sub">Raids, Dungeons und Gildentermine.</div>
      <div class="panel">
        <h3>Anstehende Termine</h3>
        ${sorted.length ? rows : `<div class="empty-note">Noch keine Termine eingetragen.</div>`}
      </div>
      ${admin ? `
      <div class="panel">
        <h3>Neuen Termin anlegen</h3>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <div class="field" style="flex:1; min-width:170px;">
            <label for="ev-typ">Event-Typ</label>
            <select id="ev-typ">
              ${EVENT_TYPE_ORDER.map(t=>`<option value="${t}" ${t===currentTyp?'selected':''}>${EVENT_TYPES[t].icon} ${EVENT_TYPES[t].label}</option>`).join("")}
            </select>
          </div>
          <div class="field" style="flex:1; min-width:190px;">
            <label for="ev-name">${contentList ? "Dungeon / Raid" : "Titel"}</label>
            ${contentList
              ? `<select id="ev-name">${contentList.map(c=>`<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join("")}</select>`
              : `<input id="ev-name" type="text" placeholder="z. B. Gildenausflug">`}
          </div>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <div class="field" style="flex:1; min-width:150px;"><label for="ev-date">Datum</label><input id="ev-date" type="date"></div>
          <div class="field" style="flex:1; min-width:120px;"><label for="ev-time">Uhrzeit</label><input id="ev-time" type="time"></div>
        </div>
        <div class="field"><label for="ev-desc">Beschreibung</label><textarea id="ev-desc" placeholder="Details zum Termin, z. B. benötigte Rollen"></textarea></div>
        <button class="btn btn-primary" id="add-event-btn">Termin hinzufügen</button>
      </div>` : ""}
    `;
  }

  function renderTicket(){
    const user = state.currentUser;
    const admin = isAdmin(user);
    const visible = admin ? state.tickets : state.tickets.filter(t=>t.author===user.name);

    const items = visible.map(t => `
      <div class="ticket-item">
        <div class="ticket-top">
          <h4>${escapeHtml(t.title)}</h4>
          <span class="status status-${t.status}">${t.status}</span>
        </div>
        <div class="ticket-meta">von ${escapeHtml(t.author)}</div>
        <div class="ticket-desc">${escapeHtml(t.desc)}</div>
        ${t.replies.map(r=>`<div class="reply"><div class="who">${escapeHtml(r.by)}</div>${escapeHtml(r.text)}</div>`).join("")}
        ${admin ? `
          <div class="reply-form">
            <input type="text" placeholder="Antwort schreiben…" data-reply-input="${t.id}">
            <button class="btn btn-ghost btn-small" data-action="reply" data-id="${t.id}">Antworten</button>
          </div>
          <div class="ticket-actions">
            <button class="btn ${t.status==='Offen'?'btn-primary':'btn-ghost'} btn-small" data-action="toggle-status" data-id="${t.id}">
              ${t.status==='Offen' ? 'Als geschlossen markieren' : 'Wieder öffnen'}
            </button>
          </div>
        ` : ""}
      </div>
    `).join("");

    return `
      <div class="page-title">Tickets</div>
      <div class="page-sub">${admin ? "Alle Anliegen der Gildenmitglieder." : "Deine Anliegen an die Gildenleitung."}</div>

      <div class="panel">
        <h3>Neues Ticket erstellen</h3>
        <div class="field"><label for="tk-title">Titel</label><input id="tk-title" type="text" placeholder="Kurze Zusammenfassung"></div>
        <div class="field"><label for="tk-desc">Beschreibung</label><textarea id="tk-desc" placeholder="Was ist dein Anliegen?"></textarea></div>
        <button class="btn btn-primary" id="add-ticket-btn">Ticket absenden</button>
      </div>

      <div class="panel">
        <h3>${admin ? "Alle Tickets" : "Deine Tickets"}</h3>
        ${visible.length ? items : `<div class="empty-note">Keine Tickets vorhanden.</div>`}
      </div>
    `;
  }

  function renderAdmin(){
    const dist = RANK_ORDER.map(r => ({r, count: state.members.filter(m=>m.rank===r).length}));
    const max = Math.max(1, ...dist.map(d=>d.count));
    return `
      <div class="page-title">Admin-Bereich</div>
      <div class="page-sub">Nur sichtbar für Leader und Co-Leader.</div>

      <div class="stat-grid">
        <div class="stat"><div class="num">${state.members.length}</div><div class="label">Mitglieder gesamt</div></div>
        <div class="stat"><div class="num">${state.tickets.filter(t=>t.status==='Offen').length}</div><div class="label">Offene Tickets</div></div>
        <div class="stat"><div class="num">${state.events.length}</div><div class="label">Geplante Termine</div></div>
        <div class="stat"><div class="num">${state.classes.length}</div><div class="label">Klassen im Einsatz</div></div>
      </div>

      <div class="panel">
        <h3>Rangverteilung</h3>
        <div class="rank-dist">
          ${dist.map(d=>`
            <div class="rank-bar-row">
              <span class="rlabel">${RANK_LABEL[d.r]}</span>
              <div class="rank-bar-track"><div class="rank-bar-fill" style="width:${(d.count/max)*100}%"></div></div>
              <span class="rcount">${d.count}</span>
            </div>
          `).join("")}
        </div>
      </div>

      <div class="panel">
        <h3>Hinweis</h3>
        <p style="color:var(--text-dim); font-size:13.5px; line-height:1.6;">
          Rang- und Klassenänderungen sowie das Entfernen von Mitgliedern erfolgen im Bereich „Member“.
          Dort findest du hinter jeder Zeile den Admin-Bereich mit den passenden Steuerelementen.
        </p>
      </div>
    `;
  }

  /* ---------------- Render dispatcher ---------------- */
  function render(){
    renderNav();
    const main = document.getElementById("main");
    switch(state.view){
      case "home": main.innerHTML = renderHome(); break;
      case "member": main.innerHTML = renderMember(); attachMemberEvents(); break;
      case "kalender": main.innerHTML = renderKalender(); attachKalenderEvents(); break;
      case "ticket": main.innerHTML = renderTicket(); attachTicketEvents(); break;
      case "admin": main.innerHTML = isAdmin(state.currentUser) ? renderAdmin() : renderHome(); break;
      default: main.innerHTML = renderHome();
    }
  }

  /* ---------------- Event wiring per view ---------------- */
  function attachMemberEvents(){
    // row "⋮" menu: toggle open/close
    document.querySelectorAll('[data-action="toggle-row-menu"]').forEach(btn=>{
      btn.addEventListener("click", (e)=>{
        e.stopPropagation();
        state.openRowMenu = state.openRowMenu === btn.dataset.id ? null : btn.dataset.id;
        render();
      });
    });
    document.querySelectorAll('[data-action="set-rank"]').forEach(btn=>{
      btn.addEventListener("click", async ()=>{
        const m = state.members.find(x=>x.id===btn.dataset.id);
        if(m){ m.rank = btn.dataset.rank; state.openRowMenu = null; await saveMembers(); render(); }
      });
    });
    document.querySelectorAll('[data-action="remove"]').forEach(btn=>{
      btn.addEventListener("click", async ()=>{
        const m = state.members.find(x=>x.id===btn.dataset.id);
        if(!m) return;
        if(!confirm(`${m.name} wirklich aus der Gilde entfernen?`)) return;
        state.members = state.members.filter(x=>x.id!==btn.dataset.id);
        state.openRowMenu = null;
        await saveMembers();
        render();
      });
    });
    // close the row popover when clicking anywhere else
    document.addEventListener("click", closeRowMenuOnce, {once:true});
    function closeRowMenuOnce(){
      if(state.openRowMenu){ state.openRowMenu = null; render(); }
    }

    // "⋯" behind Klasse: open the multi-class modal
    document.querySelectorAll('[data-action="open-class-modal"]').forEach(btn=>{
      btn.addEventListener("click", (e)=>{
        e.stopPropagation();
        state.openClassModalFor = btn.dataset.id;
        render();
      });
    });
    const closeClassModal = document.getElementById("close-class-modal");
    if(closeClassModal){
      closeClassModal.addEventListener("click", ()=>{ state.openClassModalFor = null; render(); });
    }
    const classModalOverlay = document.getElementById("class-modal-overlay");
    if(classModalOverlay){
      classModalOverlay.addEventListener("click", (e)=>{
        if(e.target === classModalOverlay){ state.openClassModalFor = null; render(); }
      });
    }
    document.querySelectorAll('[data-action="toggle-klasse"]').forEach(cb=>{
      cb.addEventListener("change", async ()=>{
        const m = state.members.find(x=>x.id===state.openClassModalFor);
        if(!m) return;
        const cls = cb.dataset.class;
        m.klassen = m.klassen || [];
        if(cb.checked){
          if(!m.klassen.includes(cls)) m.klassen.push(cls);
        } else {
          m.klassen = m.klassen.filter(c=>c!==cls);
        }
        await saveMembers();
        render();
      });
    });
    document.querySelectorAll('[data-action="set-haupt"]').forEach(btn=>{
      btn.addEventListener("click", async ()=>{
        const m = state.members.find(x=>x.id===state.openClassModalFor);
        if(!m) return;
        m.hauptklasse = btn.dataset.class;
        if(!m.klassen.includes(m.hauptklasse)) m.klassen.push(m.hauptklasse);
        await saveMembers();
        render();
      });
    });

    // global guild class list (add / rename / delete class types)
    document.querySelectorAll('[data-action="rename-class"]').forEach(input=>{
      input.addEventListener("change", async ()=>{
        const orig = input.dataset.orig;
        const val = input.value.trim();
        if(!val || val===orig) { input.value = orig; return; }
        if(state.classes.includes(val)){ alert("Diese Klasse existiert bereits."); input.value = orig; return; }
        state.classes = state.classes.map(c=> c===orig ? val : c);
        state.members.forEach(m=>{
          if(m.hauptklasse===orig) m.hauptklasse = val;
          m.klassen = (m.klassen||[]).map(c=> c===orig ? val : c);
        });
        await saveClasses(); await saveMembers();
        render();
      });
    });
    document.querySelectorAll('[data-action="delete-class"]').forEach(btn=>{
      btn.addEventListener("click", async ()=>{
        const cls = btn.dataset.class;
        const inUse = state.members.filter(m=>(m.klassen||[]).includes(cls)).length;
        if(inUse > 0 && !confirm(`${inUse} Mitglied(er) spielen "${cls}". Trotzdem löschen?`)) return;
        state.classes = state.classes.filter(c=>c!==cls);
        state.members.forEach(m=>{
          m.klassen = (m.klassen||[]).filter(c=>c!==cls);
          if(m.hauptklasse===cls) m.hauptklasse = m.klassen[0] || "";
        });
        await saveClasses(); await saveMembers();
        render();
      });
    });
    const addBtn = document.getElementById("add-class-btn");
    if(addBtn){
      addBtn.addEventListener("click", async ()=>{
        const input = document.getElementById("new-class-input");
        const val = input.value.trim();
        if(!val) return;
        if(state.classes.includes(val)){ alert("Diese Klasse existiert bereits."); return; }
        state.classes.push(val);
        await saveClasses();
        render();
      });
    }
  }

  function attachKalenderEvents(){
    document.querySelectorAll('[data-action="delete-event"]').forEach(btn=>{
      btn.addEventListener("click", async ()=>{
        state.events = state.events.filter(e=>e.id!==btn.dataset.id);
        await saveEvents();
        render();
      });
    });
    const typSelect = document.getElementById("ev-typ");
    if(typSelect){
      typSelect.addEventListener("change", ()=>{
        state.newEventTyp = typSelect.value;
        render();
      });
    }
    const addBtn = document.getElementById("add-event-btn");
    if(addBtn){
      addBtn.addEventListener("click", async ()=>{
        const typ = document.getElementById("ev-typ").value;
        const name = document.getElementById("ev-name").value.trim();
        const date = document.getElementById("ev-date").value;
        const time = document.getElementById("ev-time").value || "20:00";
        const desc = document.getElementById("ev-desc").value.trim();
        if(!name || !date){ alert("Bitte Dungeon/Raid bzw. Titel sowie Datum angeben."); return; }
        state.events.push({id:uid(), typ, name, date, time, desc});
        await saveEvents();
        render();
      });
    }
  }

  function attachTicketEvents(){
    const addBtn = document.getElementById("add-ticket-btn");
    if(addBtn){
      addBtn.addEventListener("click", async ()=>{
        const title = document.getElementById("tk-title").value.trim();
        const desc = document.getElementById("tk-desc").value.trim();
        if(!title || !desc){ alert("Bitte Titel und Beschreibung angeben."); return; }
        state.tickets.unshift({id:uid(), title, desc, author:state.currentUser.name, status:"Offen", replies:[]});
        await saveTickets();
        render();
      });
    }
    document.querySelectorAll('[data-action="reply"]').forEach(btn=>{
      btn.addEventListener("click", async ()=>{
        const input = document.querySelector(`[data-reply-input="${btn.dataset.id}"]`);
        const text = input.value.trim();
        if(!text) return;
        const t = state.tickets.find(x=>x.id===btn.dataset.id);
        t.replies.push({by:state.currentUser.name, text});
        await saveTickets();
        render();
      });
    });
    document.querySelectorAll('[data-action="toggle-status"]').forEach(btn=>{
      btn.addEventListener("click", async ()=>{
        const t = state.tickets.find(x=>x.id===btn.dataset.id);
        t.status = t.status === "Offen" ? "Geschlossen" : "Offen";
        await saveTickets();
        render();
      });
    });
  }

  /* ---------------- Init ---------------- */
  loadAll();
})();
</script>
</body>
</html>
